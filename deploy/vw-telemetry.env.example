# Copy to /etc/buspi/vw-telemetry.env (root, chmod 0600). NEVER commit a filled-in copy.
VWID_USER=you@example.com
VWID_PASSWORD=
# volkswagen|audi|skoda|seat|cupra|bentley
VW_BRAND=volkswagen
VW_COUNTRY=DE
# blank = all vehicles on the account
VW_VIN_ALLOWLIST=
INFLUX_URL=http://localhost:8086
INFLUX_ORG=home
INFLUX_BUCKET=vehicle
INFLUX_TOKEN=
